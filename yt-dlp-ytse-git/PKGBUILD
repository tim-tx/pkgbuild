_pkgname=yt-dlp-ytse
pkgname=yt-dlp-ytse-git
pkgver=r39.83bef2f
pkgrel=1
pkgdesc='Experimental YouTube streaming features for yt-dlp'
conflicts=("${_pkgname}")
provides=("${_pkgname}=${pkgver}")
arch=(any)
url='https://github.com/coletdjnz/yt-dlp-ytse'
license=('MIT')
depends=(yt-dlp python-protobug)
makedepends=(python-build python-installer python-wheel)
source=($_pkgname::git+https://github.com/coletdjnz/yt-dlp-ytse)
sha256sums=('SKIP')

pkgver() {
    cd "${_pkgname}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "${_pkgname}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${_pkgname}"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
}
